// JAVA PROGRAMMING LANGUAGE
// CODE PROPER
// SYNTAX

public class Main {
    public static void main(String[] args) {
        // Data types and variables
        int age = 20;
        double price = 16.99;
        float weight = 30.6f;
        char grade = 'D';
        boolean isStudent = true;
        String name = "Daine";

        System.out.println("Hello, World!");
        System.out.println("Name: " + name);
        System.out.println("Age: " + age);
        System.out.println("Price: " + price);
        System.out.println("Weight: " + weight);
        System.out.println("Grade: " + grade);
        System.out.println("Is Student? " + isStudent);

        // Arithmetic operators
        int a = 20, b = 6;
        System.out.println("a + b = " + (a + b));
        System.out.println("a - b = " + (a - b));
        System.out.println("a * b = " + (a * b));
        System.out.println("a / b = " + (a / b));
        System.out.println("a % b = " + (a % b));
        double x = 20, y = 6;
        System.out.println("x / y = " + (x / y));

        // Relational operators
        System.out.println("a == b: " + (a == b));
        System.out.println("a != b: " + (a != b));
        System.out.println("a > b: " + (a > b));
        System.out.println("a < b: " + (a < b));
        System.out.println("a >= b: " + (a >= b));
        System.out.println("a <= b: " + (a <= b));

        // Logical operators
        boolean p = true, q = false;
        System.out.println("p && q: " + (p && q));
        System.out.println("p || q: " + (p || q));
        System.out.println("!q: " + (!q));
        System.out.println("!p: " + (!p));

        // Assignment operators
        int score = 50;
        score += 10;
        System.out.println("score after += 10: " + score);
        score *= 2;
        System.out.println("score after *= 2: " + score);

        // Increment and decrement expressions
        int counter = 5;
        System.out.println("counter++ (post): " + counter++);
        System.out.println("counter now: " + counter);
        System.out.println("++counter (pre): " + ++counter);

        // Control flow examples use defaults to avoid requiring stdin.
        int examScore = 85;
        if (examScore >= 90) {
            System.out.println("Grade: A");
        } else if (examScore >= 80) {
            System.out.println("Grade: B");
        } else if (examScore >= 70) {
            System.out.println("Grade: C");
        } else {
            System.out.println("Grade: F");
       }

        int day = 1;
        switch (day) {
            case 1: System.out.println("Monday"); break;
            case 2: System.out.println("Tuesday"); break;
            case 3: System.out.println("Wednesday"); break;
            case 4: System.out.println("Thursday"); break;
            case 5: System.out.println("Friday"); break;
            case 6: System.out.println("Saturday"); break;
            case 7: System.out.println("Sunday"); break;
            default: System.out.println("Invalid day"); break;
        }
    }
}
